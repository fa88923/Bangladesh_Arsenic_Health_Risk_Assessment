{
  "config_version": "1.0.0",
  "status": "draft - Phase 1 (Member 1); hold points listed in docs/parameter_decision_register.md",
  "raw_inputs": {
    "arsenic_bgs": "data/raw/NationalSurveyData.csv",
    "adult_bw_steps": "data/raw/bgd2018.csv",
    "child_bw_mics": "data/raw/BGD_2025_MICS7_v01_M/BGD_2025_MICS7_v01_M/BGD_2025_MICS7_Datasets/Bangladesh MICS7 Datasets/Bangladesh MICS7 Datasets/Bangladesh MICS7 SPSS Datasets/ch.sav"
  },
  "arsenic": {
    "bgs_header_row": 4,
    "bgs_units_row_present": true,
    "source_unit": "ug/L",
    "model_unit": "mg/L",
    "ugL_to_mgL_divisor": 1000.0,
    "censor_prefix": "<",
    "selected_districts": [
      "Dhaka",
      "Chittagong",
      "Rajshahi",
      "Khulna",
      "Barisal",
      "Sylhet",
      "Rangpur",
      "Mymensingh",
      "Comilla",
      "Bogra"
    ],
    "high_censoring_warning_percent": 50.0,
    "district_selection_rationale": "Purposive: balances geographic coverage, national importance, sample count and censoring burden. Rajshahi carries an explicit high-censoring warning.",
    "candidate_distributions": ["normal", "lognormal", "gamma"],
    "primary_fit": "left-censoring-aware (reverse Kaplan-Meier) empirical CDF + CDF least squares",
    "robustness_fit": "censored maximum likelihood",
    "censored_substitution": "none",
    "lognormal_gamma_location": 0.0,
    "bootstrap_replicates": 1000,
    "objective_region": "above_initial_mass",
    "objective_region_rationale": "Decision 9.1 variant V2: the reverse-KM curve is flat at height F_hat_0 (the censored mass) for every x below the smallest detected value, and cumulative_density_ opens with a placeholder point at x=0. Those plateau points carry no shape information about the fitted density and the placeholder actively pulls the fit, so the CDF least-squares objective uses only the points strictly above the initial mass.",
    "normal_max_nonpositive_prob": 1e-4,
    "selection_rule": "lowest_cdf_rmse_among_admissible",
    "parameter_magnitude_band": {"min": 1e-08, "max": 1000000.0},
    "bootstrap_seed": 20260923,
    "bootstrap_tie_tolerance": 1e-09,
    "selection_status": "provisional - requires team review before freezing"
  },
  "bodyweight": {
    "adult_population": "STEPS 2018, age 18-69 years",
    "child_population": "MICS7, age 0-59 months (under-5 only)",
    "adult_weight_column": "m12",
    "adult_survey_weight_column": "wstep2",
    "child_weight_column": "AN8",
    "child_survey_weight_column": "chweight",
    "candidate_distributions": ["normal", "lognormal", "gamma", "triangular"]
  },
  "risk_model": {
    "status": "Phase 6 (Member 4); decisions of 2026-09-25 recorded in docs/phase6_risk_equation_design.md; team sign-off pending",
    "base_paper": "Yadav & Kalkal (2024), J. Water Health 22(12):2304-2319, doi:10.2166/wh.2024.188, Table 2",
    "plus_minus_interpretation": "arithmetic_mean_sd",
    "plus_minus_interpretation_options": ["arithmetic_mean_sd", "log_space"],
    "constants": {
        "Kp_cm_per_h": 0.001,
        "CF_L_per_cm_m2": 10.0,
        "RfD_ing_mg_per_kg_day": 0.0003,
        "RfD_dermal_mg_per_kg_day": 0.000285,
        "CSF_per_mg_per_kg_day": 1.5,
        "days_per_year": 365,
        "lifetime_years": 70
    },
    "cancer_averaging_time": "lifetime",
    "cancer_averaging_time_options": ["lifetime", "exposure_duration"],
    "populations": {
        "adult": {
            "ED_years": 70,
            "deterministic": {"IR_L_per_day": 2.0, "EF_days_per_year": 365.0, "ET_h_per_day": 0.58, "SA_m2": 1.8},
            "stochastic": {
                "IR_L_per_day": {"family": "Lognormal", "reported_mean": 1.26, "reported_sd": 0.66},
                "EF_days_per_year": {"family": "Triangular", "min": 180.0, "mode": 345.0, "max": 365.0},
                "ET_h_per_day": {"family": "Triangular", "min": 0.13, "mode": 0.20, "max": 0.33},
                "SA_m2": {"family": "Lognormal", "reported_mean": 1.42, "reported_sd": 0.31}
            }
        },
        "child": {
            "ED_years": 6,
            "deterministic": {"IR_L_per_day": 1.8, "EF_days_per_year": 365.0, "ET_h_per_day": 0.58, "SA_m2": 0.6},
            "stochastic": {
                "IR_L_per_day": {"family": "Lognormal", "reported_mean": 1.26, "reported_sd": 0.66},
                "EF_days_per_year": {"family": "Triangular", "min": 180.0, "mode": 345.0, "max": 365.0},
                "ET_h_per_day": {"family": "Triangular", "min": 0.13, "mode": 0.20, "max": 0.33},
                "SA_m2": {"family": "Triangular", "min": 0.29, "mode": 0.60, "max": 0.95,
                          "source": "min: US EPA EFH 2011 Table 7-1 mean total SA birth-<1 month; mode: base-paper deterministic child SA (EFH 2-<3 y mean 0.61); max: EFH Table 7-1 P95 3-<6 years"}
            }
        }
    }
  },
  "simulation": {
    "master_seed": 20260923,
    "seed_derivation": "numpy.random.SeedSequence(master_seed, spawn_key=(district_index, population_index, n_index, replicate))",
    "sampling": "numpy Generator.uniform + scipy.stats <dist>.ppf (explicit inverse CDF)",
    "input_dependence": "independent",
    "primary_N": 10000,
    "convergence_N": [1000, 5000, 10000, 20000],
    "replicate_seeds_per_N": 5,
    "populations": ["adult", "child"],
    "iteration_storage": "parquet",
    "master_seed_status": "frozen 2026-09-25 by Member 4 before the first recorded run",
    "uniform_open_interval": "u = Generator.uniform(tiny, 1.0) so u > 0 and every ppf stays finite and positive",
    "input_order": ["C_mg_per_L", "IR_L_per_day", "BW_kg", "EF_days_per_year", "ET_h_per_day", "SA_m2"],
    "input_selection": {
      "decided": "2026-09-25, Member 4; rationale in reports/simulation_report.md",
      "arsenic_family_overrides": {"Barisal": "Gamma"},
      "child_bw": {"family": "TruncatedNormal", "lower_kg": 1.6},
      "deterministic_C": "reverse_km_mean"
    },
    "stored_columns": "sampled inputs + ADD, HQ, HI, ELCR outputs (float64)",
    "elcr_threshold": 1e-4,
    "hi_thresholds": [1.0, 2.0]
  },
  "fixed_policies": {
    "raw_data_read_only": true,
    "automatic_outlier_trimming": false,
    "survey_weights_required_for_bw": true
  }
}
